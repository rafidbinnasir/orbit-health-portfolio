# ==============================================================================
# ORBIT Health - Environment Variables Template
# ==============================================================================
# Provide these values in your local .env.local or Vercel Project Settings.
# IMPORTANT: Never commit actual secret keys to version control.
# ==============================================================================

# Supabase Public API (Accessible in browser)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Supabase Server-Only Credentials (NEVER expose to browser)
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SECRET_KEY="your-supabase-service-role-secret-key"

# Hardware / Bio-Telemetry Ingestion (Server-Only)
ORBIT_DEVICE_TOKEN="your-secure-random-device-token-secret"
ORBIT_DEVICE_USER_ID="00000000-0000-0000-0000-000000000000"

# Google Gemini API (Server-Only AI Assistant)
GEMINI_API_KEY="AIzaSy..."
