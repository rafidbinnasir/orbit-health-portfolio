# ORBIT Health — Environment Configuration
#
# Copy this file to `.env.local` and replace the placeholder values.
# For production, configure these variables in your hosting provider's
# environment settings (e.g. Vercel or Render).
#
# IMPORTANT:
# - Never commit `.env.local` or real credentials to version control.
# - Never expose server-only secrets through NEXT_PUBLIC_ variables.


# ------------------------------------------------------------------------------
# Supabase — Public Configuration
# ------------------------------------------------------------------------------
# Used by the browser client to connect to your Supabase project.

NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"


# ------------------------------------------------------------------------------
# Supabase — Server Configuration
# ------------------------------------------------------------------------------
# Used by trusted server-side operations. Never expose these to the browser.

SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SECRET_KEY="your-supabase-secret-key"


# ------------------------------------------------------------------------------
# ORBIT Health — Device Authentication
# ------------------------------------------------------------------------------
# Used to authenticate incoming hardware and biometric telemetry requests.

ORBIT_DEVICE_TOKEN="your-device-authentication-token"
ORBIT_DEVICE_USER_ID="your-supabase-user-uuid"


# ------------------------------------------------------------------------------
# Google Gemini — AI Assistant
# ------------------------------------------------------------------------------
# API key used by the server-side AI assistant integration.

GEMINI_API_KEY="your-gemini-api-key"


# ------------------------------------------------------------------------------
# Machine Learning API — Integration
# ------------------------------------------------------------------------------
# Configure these if your Next.js application uses the separately hosted
# ORBIT Health machine learning service.

ML_API_URL="https://your-ml-api-service.onrender.com"
ML_API_SECRET="your-ml-api-secret"